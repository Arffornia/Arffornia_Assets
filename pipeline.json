  "publish": {
    "Arffornia/.github": {
      "models/space-elevator/space-elevator.anim.svg": "profile/assets/space-elevator.svg"
    },
    "Arffornia/docs": {
      "models/{id}/{id}.icon.png": "docs/assets/machines/{id}.png"
    },
    "Arffornia/Arffornia_Launcher_V.5.2": {
      "scenes/factory-line/title.loop.mp4": "src/assets/backgrounds/factory-line.mp4"
    },
    "Arffornia/Arffornia_Mods": {
      "models/{id}/{id}.glb": "(not used: the mod will consume the .bbmodel through the GeckoLib exporter, see docs/SPEC.md)"
    },
    "Arffornia/Arffornia_Provisioning": {
      "scenes/factory-line/loading-bg.night.png": "config/launcher/storage/config/fancymenu/assets/background.png",
      "brand/wordmark.png": "config/launcher/storage/config/fancymenu/assets/logo.png"
    }
  }
}
