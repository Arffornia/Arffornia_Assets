{
  "$comment": "What render/build.mjs produces. Every model in models/ gets the 'model' outputs; scenes list their own. Paths are relative to out/. 'publish' maps outputs to consumer repos (copied by render/publish.mjs into a checkout, never pushed by CI).",
  "model": [
    {
      "id": "icon",
      "kind": "still",
      "size": [
        1024,
        1024
      ],
      "transparent": true,
      "file": "models/{id}/{id}.icon.png"
    },
    {
      "id": "card",
      "kind": "still",
      "size": [
        1200,
        900
      ],
      "look": "night",
      "file": "models/{id}/{id}.night.png"
    },
    {
      "id": "turntable",
      "kind": "clip",
      "size": [
        720,
        720
      ],
      "look": "night",
      "seconds": 4,
      "fps": 24,
      "turntable": true,
      "formats": [
        "mp4",
        "webp"
      ],
      "file": "models/{id}/{id}.turntable"
    },
    {
      "id": "sheet",
      "kind": "sheet",
      "cell": 192,
      "fps": 20,
      "transparent": true,
      "file": "models/{id}/{id}.sheet.png"
    },
    {
      "id": "svg",
      "kind": "svg",
      "cell": 160,
      "fps": 12,
      "file": "models/{id}/{id}.anim.svg"
    },
    {
      "id": "glb",
      "kind": "glb",
      "file": "models/{id}/{id}.glb"
    }
  ],
  "scenes": {
    "factory-line": [
      {
        "id": "title-night",
        "kind": "still",
        "camera": "title",
        "size": [
          1920,
          1080
        ],
        "look": "night",
        "t": 3.2,
        "file": "scenes/factory-line/title.night.png"
      },
      {
        "id": "title-maquette",
        "kind": "still",
        "camera": "title",
        "size": [
          1920,
          1080
        ],
        "look": "maquette",
        "t": 3.2,
        "file": "scenes/factory-line/title.maquette.png"
      },
      {
        "id": "loop",
        "kind": "clip",
        "camera": "title",
        "size": [
          1280,
          720
        ],
        "look": "night",
        "seconds": 6,
        "fps": 30,
        "formats": [
          "mp4"
        ],
        "file": "scenes/factory-line/title.loop"
      },
      {
        "id": "early-window",
        "kind": "sheet",
        "camera": "loading",
        "size": [
          427,
