{
  "name": "arffornia-assets",
  "private": true,
  "type": "module",
  "description": "Arffornia 3D models (Blockbench) and the pipeline that re-exports every derived asset.",
  "scripts": {
    "extract": "node tools/extract-mc-screens.mjs",
    "render": "node render/build.mjs",
    "render:changed": "node render/build.mjs --changed",
    "check": "node render/build.mjs --check",
    "lint": "node tools/lint/lint.mjs --snap",
    "lint:fast": "node tools/lint/lint.mjs",
    "test": "node --test tools/lint/lint.test.mjs",
    "concepts": "node tools/da/build.mjs",
    "concepts:render": "node tools/da/render.mjs",
    "concepts:prompts": "python3 tools/concepts/generate.py prompts",
    "concepts:generate": "python3 tools/concepts/generate.py lab",
    "concepts:test": "python3 -m unittest discover -s tools/concepts",
    "concepts:review": "python3 tools/concepts/review.py out/concepts/r1",
    "tokens": "node ui/tokens/build.mjs",
    "tokens:check": "node ui/tokens/build.mjs --check && node --test ui/tokens/build.test.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
