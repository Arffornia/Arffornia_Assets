     "b": "rail_*",
     "check": "overlap",
     "why": "the roller axles run in the table rails"
    },
    {
     "a": "drive_out",
     "b": "g_drive#*",
     "check": "overlap",
     "why": "the gear is keyed on the output shaft"
    },
    {
     "a": "drive_out",
     "b": "sprk_*",
     "check": "overlap",
     "why": "the sprockets are keyed on the output shaft"
    },
    {
     "a": "idler#*",
     "b": "g_idler#*",
     "check": "overlap",
     "why": "the idler gear turns on its stub shaft"
    },
    {
     "a": "cam#*",
     "b": "g_cam#*",
     "check": "overlap",
     "why": "the big gear is keyed on the cam log"
    },
    {
     "a": "roll_*#9",
     "b": "pin_*",
     "check": "overlap",
     "why": "the pinions are keyed on the roll necks"
    },
    {
     "a": "billet",
     "b": "furnace#*",
     "check": "overlap",
     "why": "the ingot heats inside the furnace"
    },
    {
     "a": "ram*",
     "b": "cam*",
     "check": "sweep",
     "why": "the cam lobe lifts the tappet: they touch by design"
    }
   ]
