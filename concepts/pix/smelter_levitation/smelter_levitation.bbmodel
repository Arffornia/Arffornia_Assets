 "arffornia": {
  "kind": "machine",
  "status": "concept",
  "texelsPerBlock": 16,
  "title": "Smelter Mk3 (levitation melter)",
  "note": "Ore to ingots: an induction field melts the charge in mid-air above a cold copper crucible. Tier 7.",
  "footprint": [
   3,
   3
  ],
  "height": 4,
  "tier": 7,
  "lineage": "rethink",
  "ports": [
   {
    "id": "in",
    "kind": "item",
    "face": "west",
    "cell": [
     1,
     0
    ]
   },
   {
    "id": "out",
    "kind": "item",
    "face": "south",
    "cell": [
     1,
     0
    ]
   }
  ],
  "joints": {
   "charge": {
    "type": "free",
    "why": "the molten charge is held by the induction field, not by a mechanical joint"
   },
   "flow_1": {
    "type": "free",
    "why": "a glow pulse: the coolant flow lamp swells, light not matter"
   },
   "flow_2": {
    "type": "free",
    "why": "a glow pulse: the coolant flow lamp swells, light not matter"
   },
   "shield": {
    "type": "prismatic",
    "axis": "y",
    "min": 0,
    "max": 18
   },
   "shoulder": {
    "type": "revolute",
    "axis": "z",
    "min": -70,
    "max": 70
   },
   "elbow": {
    "type": "revolute",
    "axis": "z",
    "min": -240,
    "max": 60
   },
   "wrist": {
    "type": "revolute",
    "axis": "z",
    "min": -240,
    "max": 90
   }
  },
  "lint": {
   "allow": [
    {
     "a": "coil_*",
     "b": "core#*",
     "check": "overlap",
     "why": "the induction turns are wound round the coil former"
    },
    {
     "a": "charge#*",
     "b": "pyro_beam",
     "check": "overlap",
     "why": "the pyrometer beam is light aimed at the molten charge"
    },
    {
     "a": "upper#*",
     "b": "yoke#2",
     "check": "overlap",
     "why": "the shoulder pin passes through the hub of the upper arm"
    },
    {
     "a": "fore#2",
     "b": "wrist#1",
     "check": "overlap",
     "why": "the wrist knuckle turns on the end pin of the forearm"
    },
    {
     "a": "pyro*",
     "check": "cantilever",
     "why": "the pyrometer beam is light and carries no load"
    },
    {
     "a": "charge*",
     "check": "cantilever",
     "why": "the charge is held up by the induction field, not by the beam"
    }
   ]
  }
 }
}
